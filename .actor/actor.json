{
  "actorSpecification": 1,
  "name": "reed-uk-jobs-scraper",
  "title": "Reed.co.uk Jobs Scraper — UK Job Listings API",
  "description": "Scrape job listings from Reed.co.uk, UK's leading job board with 14M+ monthly visits. Extract job titles, companies, salaries, locations, and descriptions. Perfect for recruitment data, job market analysis, and AI agents. Works with Claude, ChatGPT, and AI agents via Apify MCP.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "output": {
    "actorOutputSchemaVersion": 1,
    "properties": {
      "title": {
        "type": "string",
        "title": "Job Title",
        "description": "Job position title",
        "template": "{{{title}}}"
      },
      "company": {
        "type": "string",
        "title": "Company",
        "description": "Employer name",
        "template": "{{{company}}}"
      },
      "location": {
        "type": "string",
        "title": "Location",
        "description": "Job location",
        "template": "{{{location}}}"
      },
      "salary": {
        "type": "string",
        "title": "Salary",
        "description": "Salary range if listed",
        "template": "{{{salary}}}"
      },
      "description": {
        "type": "string",
        "title": "Description",
        "description": "Job description",
        "template": "{{{description}}}"
      },
      "url": {
        "type": "string",
        "title": "URL",
        "description": "Job posting URL",
        "template": "{{{url}}}"
      },
      "scrapedAt": {
        "type": "string",
        "title": "Scraped At",
        "description": "Timestamp",
        "template": "{{{scrapedAt}}}"
      }
    }
  }
}
