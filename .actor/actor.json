{
  "actorSpecification": 1,
  "name": "reed-uk-jobs-scraper",
  "title": "Reed.co.uk Jobs Scraper — UK Job Listings API",
  "description": "Scrape job listings from Reed.co.uk, UK's leading job board with 14M+ monthly visits. Extract job titles, companies, salaries, locations, and descriptions. Perfect for recruitment data, job market analysis, and AI agents. Works with Claude, ChatGPT, and AI agents via Apify MCP.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": ["title", "company", "location", "salary", "url"]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Job Title"
              },
              "company": {
                "label": "Company"
              },
              "location": {
                "label": "Location"
              },
              "salary": {
                "label": "Salary"
              },
              "url": {
                "label": "URL",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "title": {"type": "string", "title": "Job Title"},
        "company": {"type": "string", "title": "Company"},
        "location": {"type": "string", "title": "Location"},
        "salary": {"type": "string", "title": "Salary"},
        "postedDate": {"type": "string", "title": "Posted Date"},
        "description": {"type": "string", "title": "Description"},
        "url": {"type": "string", "title": "URL"},
        "scrapedAt": {"type": "string", "title": "Scraped At"}
      }
    }
  }
}
