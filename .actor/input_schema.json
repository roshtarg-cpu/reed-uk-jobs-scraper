{
  "title": "Reed.co.uk Jobs Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchKeyword": {
      "title": "Search Keyword",
      "type": "string",
      "description": "Job keyword to search (e.g., 'software engineer', 'marketing manager')",
      "editor": "textfield",
      "example": "python developer",
      "prefill": "software engineer"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Job location (e.g., 'London', 'Manchester', 'Remote')",
      "editor": "textfield",
      "example": "London",
      "prefill": "London"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of jobs to scrape",
      "editor": "number",
      "minimum": 1,
      "maximum": 1000,
      "default": 50,
      "prefill": 10
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper",
      "editor": "proxy",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"],
        "apifyProxyCountry": "GB"
      }
    }
  },
  "required": []
}
